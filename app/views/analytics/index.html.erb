<% content_for :title, "Zendesk Explore - Raporlama & Analitik" %>

<div style="padding: 28px; max-width: 1400px; width: 100%; margin: 0 auto;">
  <!-- Header -->
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 24px;">
    <div>
      <h1 style="font-size: 1.6rem; font-weight: 800; color: #fff; margin-bottom: 4px;">
        Zendesk Explore & AI Verimlilik Raporu
      </h1>
      <p style="color: var(--text-muted); font-size: 0.9rem;">
        SLA performans metrikleri, müşteri memnuniyet endeksi (CSAT) ve yapay zeka operasyonel kazanımları.
      </p>
    </div>

    <div style="display:flex; gap: 8px;">
      <span style="background: rgba(255, 255, 255, 0.04); border: 1px solid var(--bg-card-border); padding: 8px 14px; border-radius: var(--radius-md); font-size: 0.82rem; color: var(--text-muted);">
        📅 Son 30 Gün
      </span>
    </div>
  </div>

  <!-- Performance Cards -->
  <div class="analytics-grid" style="padding:0; margin-bottom: 24px;">
    <div class="kpi-card">
      <span class="kpi-title">Ortalama İlk Yanıt Süresi (FRT)</span>
      <span class="kpi-value" style="color: #34d399;"><%= @first_response_time %></span>
      <span class="kpi-trend">SLA Hedefi: &lt; 30 dk (%96 uyum)</span>
    </div>

    <div class="kpi-card">
      <span class="kpi-title">Ortalama Çözüm Süresi (MTTR)</span>
      <span class="kpi-value" style="color: var(--azure-glow);"><%= @full_resolution_time %></span>
      <span class="kpi-trend">Önceki aya göre %18 daha hızlı</span>
    </div>

    <div class="kpi-card">
      <span class="kpi-title">Müşteri Memnuniyeti (CSAT)</span>
      <div style="display:flex; align-items:center; gap: 8px; margin-top: 4px;">
        <span class="kpi-value" style="color: #fbbf24;"><%= @csat_avg %></span>
        <span style="font-size: 1.2rem; color: #fbbf24;">★★★★★</span>
      </div>
      <span class="kpi-trend">5.0 üzerinden</span>
    </div>

    <div class="kpi-card" style="border-color: rgba(168, 85, 247, 0.4); background: linear-gradient(135deg, rgba(99, 102, 241, 0.1) 0%, rgba(19, 28, 46, 0.8) 100%);">
      <span class="kpi-title" style="color: #c084fc;">AI ile Tasarruf Edilen Süre</span>
      <span class="kpi-value" style="color: #e9d5ff;"><%= @ai_time_saved_hours %> Saat</span>
      <span class="kpi-trend" style="color: #86efac;">Otomatik çağrı özeti ve biletleme</span>
    </div>
  </div>

  <!-- Charts & Visual Breakdowns -->
  <div style="display:grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px;">
    <!-- Channel Breakdown -->
    <div style="background: var(--bg-card); border: 1px solid var(--bg-card-border); border-radius: var(--radius-lg); padding: 22px;">
      <h3 style="font-size: 0.95rem; font-weight: 700; color: #fff; margin-bottom: 16px;">
        Destek Kanalı Dağılımı
      </h3>
      <div style="display:flex; flex-direction:column; gap: 12px;">
        <% @channel_counts.each do |channel, count| %>
          <div>
            <div style="display:flex; justify-content:space-between; font-size: 0.82rem; margin-bottom: 4px;">
              <span style="color: #cbd5e1; font-weight:600;"><%= channel.upcase %></span>
              <span style="color: var(--azure-glow); font-family: var(--font-mono);"><%= count %> bilet</span>
            </div>
            <div style="height: 6px; background: rgba(255,255,255,0.06); border-radius: 3px; overflow: hidden;">
              <div style="height: 100%; width: <%= (@total_tickets > 0 ? (count.to_f / @total_tickets * 100).round : 0) %>%; background: var(--azure-gradient); border-radius: 3px;"></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Priority Breakdown -->
    <div style="background: var(--bg-card); border: 1px solid var(--bg-card-border); border-radius: var(--radius-lg); padding: 22px;">
      <h3 style="font-size: 0.95rem; font-weight: 700; color: #fff; margin-bottom: 16px;">
        Öncelik Dağılımı
      </h3>
      <div style="display:flex; flex-direction:column; gap: 12px;">
        <% @priority_counts.each do |priority, count| %>
          <div>
            <div style="display:flex; justify-content:space-between; font-size: 0.82rem; margin-bottom: 4px;">
              <span style="color: #cbd5e1; font-weight:600;"><%= priority.upcase %></span>
              <span style="color: var(--text-dim); font-family: var(--font-mono);"><%= count %> adet</span>
            </div>
            <div style="height: 6px; background: rgba(255,255,255,0.06); border-radius: 3px; overflow: hidden;">
              <div style="height: 100%; width: <%= (@total_tickets > 0 ? (count.to_f / @total_tickets * 100).round : 0) %>%; background: <%= priority == 'urgent' ? '#ef4444' : (priority == 'high' ? '#f59e0b' : '#3b82f6') %>; border-radius: 3px;"></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Call Center AI Sentiment Breakdown -->
    <div style="background: var(--bg-card); border: 1px solid var(--bg-card-border); border-radius: var(--radius-lg); padding: 22px;">
      <h3 style="font-size: 0.95rem; font-weight: 700; color: #fff; margin-bottom: 16px;">
        Görüşme Duygu Analizi (AI)
      </h3>
      <div style="display:flex; flex-direction:column; gap: 12px;">
        <% @sentiment_counts.each do |sentiment, count| %>
          <div>
            <div style="display:flex; justify-content:space-between; font-size: 0.82rem; margin-bottom: 4px;">
              <span style="color: #cbd5e1; font-weight:600;"><%= (sentiment || "Nötr").titleize %></span>
              <span style="color: var(--text-dim); font-family: var(--font-mono);"><%= count %> çağrı</span>
            </div>
            <div style="height: 6px; background: rgba(255,255,255,0.06); border-radius: 3px; overflow: hidden;">
              <div style="height: 100%; width: <%= (@total_calls > 0 ? (count.to_f / @total_calls * 100).round : 0) %>%; background: <%= sentiment == 'positive' ? '#10b981' : (sentiment == 'negative' ? '#ef4444' : '#64748b') %>; border-radius: 3px;"></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
