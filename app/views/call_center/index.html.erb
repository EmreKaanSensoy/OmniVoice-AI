<% content_for :title, "Zendesk Talk & Microsoft Call Center AI" %>

<div style="padding: 28px; max-width: 1400px; width: 100%; margin: 0 auto;">
  <!-- Header -->
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 24px;">
    <div>
      <div style="display:flex; align-items:center; gap: 8px; margin-bottom: 4px;">
        <h1 style="font-size: 1.6rem; font-weight: 800; color: #fff;">Zendesk Talk & Call Center AI</h1>
        <span style="background: rgba(0, 120, 212, 0.2); border: 1px solid var(--azure-glow); color: var(--azure-glow); font-size: 0.72rem; font-weight: 700; padding: 2px 8px; border-radius: var(--radius-full);">
          Azure Communication Services
        </span>
      </div>
      <p style="color: var(--text-muted); font-size: 0.9rem;">
        PSTN/WebRTC telefon hattı, canlı yapay zeka ses transkripsiyonu ve otomatik biletleme merkezi.
      </p>
    </div>

    <div style="display:flex; gap: 10px;">
      <a href="<%= call_center_numbers_path %>" class="btn-submit-reply" style="text-decoration:none; display:inline-flex; align-items:center; gap:8px; background: rgba(30, 41, 59, 0.8); border: 1px solid var(--bg-card-border); color: #f1f5f9;">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
        Telefon Numaraları & Santral
      </a>
      <a href="<%= call_center_softphone_path %>" class="btn-submit-reply" style="text-decoration:none; display:inline-flex; align-items:center; gap:8px;">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        WebRTC Softphone Aç
      </a>
    </div>
  </div>

  <!-- Telephony KPIs -->
  <div class="analytics-grid" style="padding:0; margin-bottom: 24px;">
    <div class="kpi-card">
      <span class="kpi-title">Toplam Çağrı Hacmi</span>
      <span class="kpi-value"><%= @total_calls %></span>
      <span class="kpi-trend">Bugünkü gelen aramalar</span>
    </div>

    <div class="kpi-card">
      <span class="kpi-title">Ortalama Görüşme Süresi (AHT)</span>
      <span class="kpi-value" style="font-family: var(--font-mono);"><%= @avg_duration_formatted %></span>
      <span class="kpi-trend" style="color: #34d399;">Hedef: &lt; 04:00</span>
    </div>

    <div class="kpi-card">
      <span class="kpi-title">Müşteri Duygu Dağılımı</span>
      <div style="display:flex; gap: 10px; margin-top: 6px;">
        <span style="color:#34d399; font-weight:700; font-size:1.1rem;"><%= @positive_sentiment_count %> Pozitif</span>
        <span style="color:#94a3b8; font-weight:700; font-size:1.1rem;"><%= @neutral_sentiment_count %> Nötr</span>
        <span style="color:#f87171; font-weight:700; font-size:1.1rem;"><%= @negative_sentiment_count %> Negatif</span>
      </div>
      <span class="kpi-trend">Azure Speech & Sentiment</span>
    </div>

    <div class="kpi-card" style="border-color: rgba(168, 85, 247, 0.4); background: linear-gradient(135deg, rgba(99, 102, 241, 0.1) 0%, rgba(19, 28, 46, 0.8) 100%);">
      <span class="kpi-title" style="color: #c084fc;">Microsoft AI Biletleme</span>
      <span class="kpi-value">%100</span>
      <span class="kpi-trend">Otomatik Özet & Etiket Başarısı</span>
    </div>
  </div>

  <!-- Call Logs Table -->
  <div style="background: var(--bg-card); border: 1px solid var(--bg-card-border); border-radius: var(--radius-lg); padding: 22px;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 16px;">
      <h3 style="font-size: 1.1rem; font-weight: 700; color: #fff;">Çağrı Geçmişi ve Yapay Zeka Raporları</h3>
      <span style="font-size: 0.8rem; color: var(--text-dim);"><%= @calls.count %> çağrı kaydedildi</span>
    </div>

    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.85rem;">
        <thead>
          <tr style="border-bottom: 1px solid var(--bg-card-border); color: var(--text-dim); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; background: rgba(15, 23, 42, 0.2);">
            <th style="padding: 12px 16px;">Arayan Müşteri</th>
            <th style="padding: 12px 14px;">Telefon Numarası</th>
            <th style="padding: 12px 14px;">Temsilci</th>
            <th style="padding: 12px 14px;">Süre</th>
            <th style="padding: 12px 14px;">Duygu Durumu</th>
            <th style="padding: 12px 14px;">Tespit Edilen Amaç (Intent)</th>
            <th style="padding: 12px 14px;">Oluşturulan Bilet</th>
            <th style="padding: 12px 16px;">Tarih</th>
          </tr>
        </thead>
        <tbody>
          <% if @calls.empty? %>
            <tr>
              <td colspan="8" style="padding: 30px; text-align: center; color: var(--text-dim);">
                Henüz kayıtlı bir telefon görüşmesi yok. Yukarıdan simülasyon başlatabilirsiniz.
              </td>
            </tr>
          <% else %>
            <% @calls.each do |call| %>
              <tr style="border-bottom: 1px solid var(--bg-card-border); transition: background 0.15s ease;" onmouseover="this.style.background='rgba(255,255,255,0.02)'" onmouseout="this.style.background='transparent'">
                <td style="padding: 14px 16px; font-weight: 600; color: #f1f5f9;">
                  <%= call.caller_name %>
                </td>
                <td style="padding: 14px 14px; font-family: var(--font-mono); color: var(--azure-glow); font-size: 0.8rem;">
                  <%= call.caller_number %>
                </td>
                <td style="padding: 14px 14px; color: var(--text-muted);">
                  <%= call.agent&.name || "AI Sesli Asistan" %>
                </td>
                <td style="padding: 14px 14px; font-family: var(--font-mono); font-weight: 600; color: #cbd5e1;">
                  <%= call.duration_formatted %>
                </td>
                <td style="padding: 14px 14px;">
                  <span class="sentiment-badge sentiment-<%= call.sentiment || 'neutral' %>">
                    <%= call.sentiment || 'neutral' %>
                  </span>
                </td>
                <td style="padding: 14px 14px; color: #e2e8f0; font-size: 0.82rem;">
                  <%= call.detected_intent.presence || "Destek Talebi" %>
                </td>
                <td style="padding: 14px 14px;">
                  <% if call.ticket %>
                    <a href="<%= ticket_path(call.ticket) %>" style="color: var(--azure-glow); font-weight: 700; text-decoration: none;">
                      <%= call.ticket.formatted_number %> →
                    </a>
                  <% else %>
                    <span style="color: var(--text-dim);">-</span>
                  <% end %>
                </td>
                <td style="padding: 14px 16px; color: var(--text-dim); font-size: 0.78rem;">
                  <%= time_ago_in_words(call.created_at) %> önce
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
