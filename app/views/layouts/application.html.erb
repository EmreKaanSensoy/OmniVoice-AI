<!DOCTYPE html>
<html lang="tr">
  <head>
    <title><%= content_for(:title) || "Zendesk & Microsoft Call Center AI" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#090d16">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="app-container">
      <% if logged_in? %>
        <!-- Left Global Dock (Icon Navigation) -->
        <aside class="global-dock">
          <a href="<%= dashboard_path %>" class="dock-logo" title="Zendesk + Microsoft Call Center AI">
            Z
            <div class="ai-spark" title="Microsoft Azure AI Aktif"></div>
          </a>

          <nav class="dock-nav">
            <a href="<%= dashboard_path %>" class="dock-item <%= 'active' if controller_name == 'dashboard' %>" title="Kontrol Paneli (Dashboard)">
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
            </a>

            <a href="<%= tickets_path %>" class="dock-item <%= 'active' if controller_name == 'tickets' %>" title="Gelen Telefon Biletleri">
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/></svg>
              <% unresolved_badge = current_organization&.tickets&.unresolved&.count || 0 %>
              <% if unresolved_badge > 0 %>
                <span class="dock-badge"><%= unresolved_badge %></span>
              <% end %>
            </a>

            <a href="<%= call_center_path %>" class="dock-item <%= 'active' if controller_name == 'call_center' && action_name == 'index' %>" title="Çağrı Merkezi Geçmişi (Talk & AI)">
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            </a>

            <a href="<%= call_center_numbers_path %>" class="dock-item <%= 'active' if controller_name == 'call_center' && action_name == 'numbers' %>" title="Telefon Numarası & Santral Ayarları">
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
            </a>

            <a href="<%= knowledge_articles_path %>" class="dock-item <%= 'active' if controller_name == 'knowledge_articles' %>" title="Bilgi Bankası (Guide)">
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
            </a>

            <a href="<%= analytics_path %>" class="dock-item <%= 'active' if controller_name == 'analytics' %>" title="Raporlar & Analiz (Explore)">
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
            </a>
          </nav>

          <div class="dock-bottom">
            <div class="agent-avatar-btn" title="<%= current_user.name %> (<%= current_user.role.titleize %>)">
              <%= current_user.initials %>
            </div>
            <%= button_to logout_path, method: :delete, class: "dock-item", title: "Çıkış Yap", style: "background:none; border:none; cursor:pointer;" do %>
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
            <% end %>
          </div>
        </aside>
      <% end %>

      <!-- Main Workspace Canvas -->
      <main class="workspace-canvas" style="<%= 'margin-left: 0; width: 100%;' unless logged_in? %>">
        <% if logged_in? %>
          <!-- Top Header Strip -->
          <header class="top-header">
            <div class="header-left">
              <div class="tenant-badge">
                <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#10b981;"></span>
                <%= current_organization.name %>
              </div>

              <!-- Support Hotline Display Badge -->
              <a href="<%= call_center_numbers_path %>" style="display:inline-flex; align-items:center; gap: 6px; padding: 4px 12px; background: rgba(0, 120, 212, 0.12); border: 1px solid rgba(56, 189, 248, 0.3); border-radius: var(--radius-full); text-decoration:none; color: #38bdf8; font-size: 0.75rem; font-weight:700; font-family: var(--font-mono);">
                <span>📞 Santral Hattı:</span>
                <span><%= current_organization.phone_number_formatted %></span>
              </a>

              <%= form_with url: tickets_path, method: :get, local: true, class: "search-box" do |f| %>
                <svg width="16" height="16" fill="none" stroke="#64748b" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                <input type="text" name="q" value="<%= params[:q] %>" placeholder="Biletlerde, müşteri numaralarında ara...">
              <% end %>
            </div>

            <div class="header-right">
              <div style="display:flex; align-items:center; gap:12px;">
                <div style="display:flex; align-items:center; gap:6px; font-size:0.75rem; color:#34d399; background:rgba(16,185,129,0.1); border:1px solid rgba(16,185,129,0.25); padding:4px 10px; border-radius:var(--radius-full);">
                  <span style="display:inline-block; width:6px; height:6px; border-radius:50%; background:#10b981;"></span>
                  <span><%= current_user.name %> (Çevrimiçi)</span>
                </div>

                <a href="<%= new_ticket_path %>" class="btn-submit-reply" style="text-decoration:none; display:inline-flex; align-items:center; gap:6px; padding: 7px 14px; font-size: 0.82rem; font-weight:700;">
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                  Yeni Bilet
                </a>
              </div>
            </div>
          </header>
        <% end %>

        <!-- Flash alerts -->
        <% if notice.present? %>
          <div class="flash-notice">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <%= notice %>
          </div>
        <% end %>

        <% if alert.present? %>
          <div class="flash-alert">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <%= alert %>
          </div>
        <% end %>

        <!-- Dynamic Content Body -->
        <div class="content-body">
          <%= yield %>
        </div>
      </main>
    </div>
  </body>
</html>
